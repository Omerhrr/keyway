# Copy to ".env" next to docker-compose.yml on the VPS (never commit .env).
DOMAIN=keyway.rogan.live

# >= 32 random chars:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
KEYWAY_SECRET_KEY=

# Used once, on first start of the empty database, to create the administrator.
KEYWAY_BOOTSTRAP_ADMIN_EMAIL=
KEYWAY_BOOTSTRAP_ADMIN_PASSWORD=
KEYWAY_BOOTSTRAP_ADMIN_NAME=Administrator

# AI extraction service is not part of this stack (rules-only parsing is used).
KEYWAY_LLM_ENABLED=false

# WhatsApp Cloud API (leave SIMULATOR until Meta is configured; see docs/WHATSAPP_SETUP.md)
KEYWAY_WHATSAPP_MODE=SIMULATOR
KEYWAY_WHATSAPP_ACCESS_TOKEN=
KEYWAY_WHATSAPP_PHONE_NUMBER_ID=
KEYWAY_WHATSAPP_WABA_ID=
KEYWAY_WHATSAPP_APP_SECRET=
KEYWAY_WHATSAPP_VERIFY_TOKEN=
