# Keyway backend environment (copy to .env and adjust)
# SQLite by default; point at Postgres for production, e.g.:
#   postgresql+psycopg://keyway:keyway@localhost:5432/keyway
DATABASE_URL=file:./db/custom.db

# JWT signing key - MUST be changed in production
# SECRET_KEY=change-me-to-a-long-random-string
