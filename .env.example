# Keyway environment. Copy to backend/.env and adjust (all variables use the KEYWAY_ prefix).
KEYWAY_ENV=development                    # set to "production" on the live server

# Database. SQLite for dev; Postgres for production:
#   postgresql+psycopg://keyway:STRONGPASSWORD@localhost:5432/keyway
KEYWAY_DATABASE_URL=sqlite:///./db/keyway.db

# REQUIRED in production (app refuses to boot otherwise): >= 32 random chars.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# KEYWAY_SECRET_KEY=

# Comma-separated list of the public origins; never "*" in production.
# KEYWAY_CORS_ORIGINS=https://app.example.com

# First boot of an EMPTY production database creates this administrator (no demo data).
# KEYWAY_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# KEYWAY_BOOTSTRAP_ADMIN_PASSWORD=       # >= 12 chars; change after first login

# WhatsApp Cloud API (webhook is rejected unless the app secret is set)
# KEYWAY_WHATSAPP_MODE=CLOUD_API
# KEYWAY_WHATSAPP_ACCESS_TOKEN=
# KEYWAY_WHATSAPP_PHONE_NUMBER_ID=
# KEYWAY_WHATSAPP_APP_SECRET=
# KEYWAY_WHATSAPP_VERIFY_TOKEN=          # not "keyway-verify" in production

# Frontend server -> API URL (default http://127.0.0.1:8000)
# KEYWAY_API_URL=http://127.0.0.1:8000
